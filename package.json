    "express": "5.1.0",
    "helmet": "8.1.0",
    "imapflow": "^2.0.0",
    "jsonwebtoken": "9.0.2",
    "mailparser": "^3.9.23",
    "ws": "8.18.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "24.3.0",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "prisma": "6.12.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
