NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root@localhost:3306/goldzone
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
FRONTEND_ORIGIN=http://localhost:5173

# Phòng bắn cá. Đặt FISH_READY_TO_START=1 khi cần tự test một mình.
FISH_ROOM_CAPACITY=6
FISH_READY_TO_START=4
FISH_START_COUNTDOWN_MS=30000

# Email Reader — đọc email thông báo giao dịch của Timo (SRS mục 18).
# Để 0 khi dev: worker sẽ không khởi động và không cần hộp thư thật.
EMAIL_READER_ENABLED=0
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
# Gmail yêu cầu App Password (16 ký tự), không dùng được mật khẩu đăng nhập thường.
# Tạo tại https://myaccount.google.com/apppasswords (phải bật 2FA trước).
# Điền xong chạy `npm run email:check` để kiểm tra khô trước khi bật worker.
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Chỉ đọc thư gửi từ địa chỉ chứa chuỗi này; để rỗng thì đọc mọi thư chưa đọc.
EMAIL_SENDER_FILTER=timo.vn
EMAIL_POLL_INTERVAL_MS=60000
EMAIL_LOOKBACK_DAYS=7

# Hạn mức rút tiền
WITHDRAW_MIN=50000
WITHDRAW_MAX=100000000
